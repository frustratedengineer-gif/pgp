__pycache__/
*.py[cod]
.venv/
.env
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# data: keep loaders, splits and samples only
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
!data/samples/**
!data/splits/**

# artefacts
*.ckpt
*.pt
*.bin
*.faiss
*.sqlite
wandb/
outputs/
lightning_logs/
# ...except: these are small MLP heads (<2MB), not foundation models --
# cheap enough to commit directly instead of pushing to a model hub. Only
# the ONE primary/reference checkpoint per model is committed this way;
# the per-seed sweep checkpoints under experiments/{main,joint}/*/ stay
# gitignored and regenerable (configs/logs/scores ARE committed there, so
# the exact run is still fully reproducible without the weights).
!artifacts/survival_model_net.pt
!artifacts/joint_model.pt

# artifacts/embeddings, artifacts/features: regenerable from data/processed
# + scripts/train.py / features/pipeline.py (tens of MB) -- not worth
# committing. Baseline score JSONs are small and reviewer-useful, so those
# ARE committed.
artifacts/embeddings/*.npy
artifacts/embeddings/*.txt
artifacts/embeddings_bge_large/
artifacts/features/*.npy

# artifacts/demo_audit_log.jsonl: runtime output of
# scripts/run_inference_demo.py, regenerated fresh on every demo run --
# not a benchmark result, nothing to commit.
artifacts/demo_audit_log.jsonl

# results: keep committed tables/figures, ignore scratch
results/raw/*
!results/raw/.gitkeep

# artifacts/llm_cache: raw per-record LLM API responses, keyed by
# sha256(model+prompt) -- regenerable (re-running just re-queries), and
# there are thousands of tiny files (one per record per prompt variant).
# The aggregated scores (artifacts/scores/*.json) ARE committed.
artifacts/llm_cache/
