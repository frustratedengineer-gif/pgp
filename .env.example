# Copy to .env and fill in as needed. Never commit the real .env file.

# Local LLM baseline (baselines/llm_prompted_ttl.py) -- ollama serving a
# local model, no API key required by default.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct

# Only needed if a gated HuggingFace model is used for the encoder.
# HF_TOKEN=

# Only needed if the LLM baseline is switched to a hosted API instead of a
# local model (see docs/reproducibility.md for why local was chosen for
# Week 3).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
