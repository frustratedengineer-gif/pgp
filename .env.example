# Copy to .env and fill in as needed. Never commit the real .env file.

# Local LLM baseline (baselines/llm_prompted_ttl.py) -- ollama serving a
# local model, no API key required by default.
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b-instruct

# Only needed if a gated HuggingFace model is used for the encoder.
# HF_TOKEN=

# Real-API "current LLM" baselines (baselines/chatgpt_prompted_ttl.py,
# gemini_prompted_ttl.py) -- these answer the actual reviewer question
# ("did you beat GPT-4o/Gemini") that the local-model baseline can't.
# Both route through OpenRouter (one key, one OpenAI-compatible endpoint,
# routes to either model by name) -- see baselines/_openrouter_client.py.
# OPENROUTER_API_KEY=
